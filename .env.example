# 复制成 .env 后填入你自己的 key。不要把 .env 提交到 Git。
# 密钥也可以用管控台内置动作写入数据库（setFredApiKey / setBeaApiKey），
# 数据库优先、环境变量兜底；两者都没有时相关卡片会诚实显示“密钥未配置”。

# FRED（St. Louis Fed）API key —— 用于华尔街模块：实际利率、信用利差、
# 期限溢价、政策利率、金融条件、消费者信心、企业利润、广义美元、核心 PCE 等。
# 免费注册：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BEA（Bureau of Economic Analysis）API key —— 用于企业利润（NIPA T11200）。
# 免费注册：https://apps.bea.gov/api/signup/
BEA_API_KEY=

# ---- 独立运行（standalone/）的运行时配置（无密钥，都是普通配置）----
# PORT=3000
# HOST=0.0.0.0
# DATABASE_PATH=data/app.db
# REFRESH_INTERVAL_MINUTES=60
# REFRESH_ON_START=auto

